# The year is the one this version was released, not today's: a citation has
# to keep pointing at the same thing. Bump it here when you tag a new release.
year <- "2026"
# meta$Version, not packageVersion(): R CMD check reads this file with the
# package NOT installed, and packageVersion() then fails.
vers <- sprintf("R package version %s", meta$Version)
url  <- "https://github.com/danielsangarci/easypaper"

citHeader("To cite easypaper in publications, use:")

bibentry(
  bibtype  = "Manual",
  key      = "easypaper",
  title    = paste("easypaper: Automate Reproducible Quarto Manuscripts",
                   "from Draft to Submission"),
  author   = person("Daniel", "Sanchez-Garcia",
                    comment = c(ORCID = "0000-0002-0710-6292")),
  year     = year,
  note     = vers,
  url      = url,
  textVersion = paste0(
    "Sanchez-Garcia, D. (", year, "). easypaper: Automate Reproducible ",
    "Quarto Manuscripts from Draft to Submission. ", vers, ". ", url)
)
